{
  "name": "pkhosting-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/ts/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/bun": "^1.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "dev:web": "nx run web:dev",
    "check": "nx run-many --target=build && nx run-many --target=check",
    "install-all": "bash tools/install.sh",
    "lock": "bash tools/uv.sh lock"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "nx": "^23.3.0",
    "typescript": "catalog:"
  },
  "overrides": {
    "@pierre/diffs": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-core": "1.171.35",
    "@tanstack/router-devtools-core": "1.168.1",
    "@tanstack/start-server-core": "1.169.40",
    "@tanstack/start-plugin-core": "1.171.50"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@mistralai-capabilities/base-core": "0.1.71",
    "@mistralai-capabilities/deployment-apps": "0.1.71",
    "@mistralai-capabilities/frontend-tanstack-start": "0.1.71"
  }
}
